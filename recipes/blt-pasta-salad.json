{
  "title": "BLT Pasta Salad",
  "source_url": "https://www.halfbakedharvest.com/blt-pasta-salad/",
  "author": "Half Baked Harvest",
  "servings": 6,
  "prep_time": "20 minutes",
  "cook_time": "10 minutes",
  "tags": ["salad", "pasta", "summer", "bacon"],
  "ingredients": [
    {"raw": "1/2 cup plain greek yogurt or sour cream", "amount": 0.5, "unit": "cup", "name": "greek yogurt"},
    {"raw": "1/3 cup mayo", "amount": 0.33, "unit": "cup", "name": "mayo"},
    {"raw": "2 tablespoons buttermilk", "amount": 2, "unit": "tablespoon", "name": "buttermilk"},
    {"raw": "1 cup fresh basil", "amount": 1, "unit": "cup", "name": "basil"},
    {"raw": "1/2 cup fresh cilantro", "amount": 0.5, "unit": "cup", "name": "cilantro"},
    {"raw": "1/4 cup fresh chopped chives", "amount": 0.25, "unit": "cup", "name": "chives"},
    {"raw": "1 jalapeño, seeded, if desired", "amount": 1, "unit": null, "name": "jalapeño"},
    {"raw": "2 teaspoons Worcestershire", "amount": 2, "unit": "teaspoon", "name": "worcestershire"},
    {"raw": "1 teaspoon garlic powder", "amount": 1, "unit": "teaspoon", "name": "garlic powder"},
    {"raw": "1 teaspoon onion powder", "amount": 1, "unit": "teaspoon", "name": "onion powder"},
    {"raw": "kosher salt and black pepper", "amount": null, "unit": null, "name": "kosher salt and black pepper"},
    {"raw": "1 pound short cut pasta", "amount": 1, "unit": "pound", "name": "pasta"},
    {"raw": "1 cup cubed spicy cheddar cheese", "amount": 1, "unit": "cup", "name": "cheddar cheese"},
    {"raw": "1 head romaine lettuce, shredded", "amount": 1, "unit": "head", "name": "romaine lettuce"},
    {"raw": "2 cups cherry tomatoes, halved", "amount": 2, "unit": "cup", "name": "cherry tomatoes"},
    {"raw": "2 cups grilled corn (about 3 ears)", "amount": 2, "unit": "cup", "name": "grilled corn"},
    {"raw": "8 slices cooked bacon, crumbled", "amount": 8, "unit": "slice", "name": "bacon"},
    {"raw": "1 avocado, diced", "amount": 1, "unit": null, "name": "avocado"}
  ],
  "instructions": [
    {"step": 1, "text": "To make the dressing, combine all ingredients in a blender and blend until smooth. Season with salt and pepper."},
    {"step": 2, "text": "Bring a large pot of salted water to a boil. Boil the pasta to al dente, according to package directions. Drain."},
    {"step": 3, "text": "In a large bowl, toss together the hot pasta with dressing and cubes of cheese. Mix in the lettuce, tomatoes, corn, bacon, and avocado, gently tossing to combine."},
    {"step": 4, "text": "Serve warm or cold. The salad will develop more flavor as it sits. If serving later, add the bacon and avocado just before serving."}
  ]
}
